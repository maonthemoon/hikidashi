# bin/にはリリースした版のHikidashi.exe(Actionsが差し替える)と辞書(tools/update-dict.sh)だけを置く. 手元のビルドはout/(dev/があればdev/bin/)
/bin/*
!/bin/Hikidashi.exe
!/bin/SKK-JISYO.L
!/bin/SKK-JISYO.L-COPYING.txt
/out/
/target/
__pycache__/
Thumbs.db
desktop.ini

# 開発用の文書(dev/は非公開リポジトリhikidashi-dev. ルートのものはそこへのリンク)
/dev/
/HANDOFF.md
/SPEC.md
/AGENTS.md
/CLAUDE.md
